# Cau hinh SMTP de gui email that (Tool 3 khi chay voi --send).
# Copy file nay thanh `.env` roi dien thong tin that. KHONG commit file .env.
#
# Gmail: bat "App password" (mat khau ung dung) va dung no o SMTP_PASS.
#        Host smtp.gmail.com, port 587 (STARTTLS).
# Office365: smtp.office365.com, port 587.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=HR Team <your_email@gmail.com>
